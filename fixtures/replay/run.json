 {
  "seq": 55,
  "at": "2026-11-06T03:14:38.911Z",
  "type": "document_read",
  "data": {
   "via": "live",
   "docId": "will",
   "facts": [
    {
     "label": "Testator",
     "quote": "I, Ruth Calloway, a resident of Tampa, Florida, being of sound mind, declare this to be my Last Will and Testament",
     "value": "Ruth Calloway",
     "verified": true
    },
    {
     "label": "Personal Representative",
     "quote": "I name my daughter, Dana Calloway, as Personal Representative of my estate, to serve without bond.",
     "value": "Dana Calloway",
     "verified": true
    },
    {
     "label": "Specific Gift",
     "quote": "I give the sum of Two Thousand Dollars ($2,000.00) to my niece, Aoife Calloway, of Cork, Ireland.",
     "value": "$2,000.00 to niece Aoife Calloway",
     "verified": true
    },
    {
     "label": "Residuary Beneficiaries",
     "quote": "I give all the rest, residue and remainder of my estate, in equal shares, to my daughter, Dana Calloway, and my son, Tom Calloway.",
     "value": "Dana Calloway and Tom Calloway (in equal shares)",
     "verified": true
    },
    {
     "label": "Execution Date",
     "quote": "Signed at Tampa, Florida, on the 12th day of June, 2019",
     "value": "June 12, 2019",
     "verified": true
    },
    {
     "label": "Witnesses",
     "quote": "Harlan Pennick\nWitness, Tampa, Florida\n\nJune Abernethy\nWitness, Tampa, Florida",
     "value": "Harlan Pennick and June Abernethy",
     "verified": true
